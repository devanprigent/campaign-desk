{
  "name": "campaign-desk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env server.js",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-router/express": "8.5.2",
    "@react-router/node": "8.5.2",
    "express": "5.3.0",
    "isbot": "5.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
