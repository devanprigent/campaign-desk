generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Campaign {
  id            String   @id @default(uuid())
  opportunityId String
  chainId       Int
  tokenAddress  String
  tokenSymbol   String
  tokenDecimals Int
  amount        String
  fee           String
  tokenPriceUsd Float
  startAt       DateTime
  endAt         DateTime
  createdAt     DateTime @default(now())

  @@index([opportunityId])
}
